      "title": "Ranking Method",
      "type": "string"
    },
    "ranking_version": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Ranking Version",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "retrieval_path": {
      "default": "keyword",
      "title": "Retrieval Path",
      "type": "string"
    },
    "retrieval_status": {
      "$ref": "#/$defs/RetrievalStatus"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_limited": {
      "default": false,
      "title": "Scope Limited",
      "type": "boolean"
    },
    "skipped_stages": {
      "items": {
        "additionalProperties": {
