      "type": "array"
    },
    "timings_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings Ms",
      "type": "object"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "retrieval_status",
    "content_revisions",
    "timings_ms",
    "ranking_method",
    "ranking_version",
    "diagnostics",
    "hits"
  ],
  "title": "V2SearchResponse",
  "type": "object"
}
