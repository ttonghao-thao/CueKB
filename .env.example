CUEKB_ENV=development
CUEKB_BACKEND=memory
CUEKB_PROCESS_ROLE=api
CUEKB_HOST=127.0.0.1
CUEKB_PORT=8080
CUEKB_LOG_LEVEL=INFO
CUEKB_DATABASE_URL=postgresql+psycopg://cuekb:cuekb@localhost:5432/cuekb
CUEKB_OPENSEARCH_URL=http://localhost:9200
CUEKB_OPENSEARCH_INDEX_PREFIX=cuekb
CUEKB_OPENSEARCH_TIMEOUT_MS=500
CUEKB_KEYWORD_CANDIDATES=50
CUEKB_VECTOR_CANDIDATES=50
CUEKB_RERANK_CANDIDATES=30
CUEKB_STORAGE_PATH=data/originals
CUEKB_MAX_UPLOAD_BYTES=52428800
CUEKB_WORKER_POLL_SECONDS=1
CUEKB_WORKER_LEASE_SECONDS=300
CUEKB_WORKER_MAX_ATTEMPTS=3
CUEKB_MODEL_SERVICE_URL=http://localhost:8090
CUEKB_EMBEDDING_MODEL=BAAI/bge-m3
CUEKB_EMBEDDING_REVISION=
CUEKB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CUEKB_RERANKER_REVISION=
CUEKB_VECTOR_DIMENSION=1024
CUEKB_SEARCH_DEADLINE_MS=900
CUEKB_MODEL_TIMEOUT_MS=400
CUEKB_WORKER_MODEL_TIMEOUT_MS=120000
CUEKB_RERANK_MIN_REMAINING_MS=180
CUEKB_RERANK_ENABLED=true
CUEKB_MODEL_USE_FP16=false
