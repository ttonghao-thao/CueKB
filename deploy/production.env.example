# Copy to .env.production, replace every secret, then chmod 600 .env.production.
CUEKB_POSTGRES_PASSWORD=replace-with-a-long-random-password
CUEKB_API_KEY_PEPPER=replace-with-at-least-32-random-characters
CUEKB_BOOTSTRAP_API_KEY=replace-with-at-least-24-random-characters

# Embedding is required. base_url includes the OpenAI-compatible /v1 path and
# must serve POST /embeddings. Changing model requires a new OpenSearch index
# generation and reindexing chunks.
CUEKB_EMBEDDING_BASE_URL=https://embedding.example.internal/v1
CUEKB_EMBEDDING_API_KEY=replace-with-embedding-service-key
CUEKB_EMBEDDING_MODEL=BAAI/bge-m3

# Reranking is opt-in. Its base_url also includes /v1 and must expose the
# OpenAI-compatible /rerank extension. Leave all three fields empty to skip it.
CUEKB_RERANKER_BASE_URL=
CUEKB_RERANKER_API_KEY=
CUEKB_RERANKER_MODEL=
# CUEKB_RERANKER_BASE_URL=https://reranker.example.internal/v1
# CUEKB_RERANKER_API_KEY=replace-with-reranker-service-key
# CUEKB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Latency/load controls. Tune only with recorded target-host measurements.
CUEKB_OPENSEARCH_TIMEOUT_MS=500
CUEKB_KEYWORD_CANDIDATES=50
CUEKB_VECTOR_CANDIDATES=50
CUEKB_RERANK_CANDIDATES=30
CUEKB_SEARCH_DEADLINE_MS=900
CUEKB_MODEL_TIMEOUT_MS=400
CUEKB_RERANK_MIN_REMAINING_MS=180
# Applies only when CUEKB_RERANKER_BASE_URL is configured.
CUEKB_RERANK_ENABLED=true
CUEKB_VECTOR_DIMENSION=1024
