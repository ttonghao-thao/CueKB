# Copy to .env.production, replace every secret, then chmod 600 .env.production.
CUEKB_POSTGRES_PASSWORD=replace-with-a-long-random-password
CUEKB_API_KEY_PEPPER=replace-with-at-least-32-random-characters
CUEKB_BOOTSTRAP_API_KEY=replace-with-at-least-24-random-characters

# Embedding is required and is supplied by an external API. The URL must serve
# POST /embed using the contract documented in docs/SYSTEM_DESIGN.md. Changing
# its revision requires a new OpenSearch index generation and reindexing chunks.
CUEKB_EMBEDDING_SERVICE_URL=https://embedding.example.internal
CUEKB_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# Reranking is opt-in and is also supplied by an external API. Leave its URL
# empty to skip reranking.
CUEKB_RERANKER_SERVICE_URL=
CUEKB_RERANKER_REVISION=
# CUEKB_RERANKER_SERVICE_URL=https://reranker.example.internal
# CUEKB_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# Latency/load controls. Tune only with recorded target-host measurements.
CUEKB_OPENSEARCH_TIMEOUT_MS=500
CUEKB_KEYWORD_CANDIDATES=50
CUEKB_VECTOR_CANDIDATES=50
CUEKB_RERANK_CANDIDATES=30
CUEKB_SEARCH_DEADLINE_MS=900
CUEKB_MODEL_TIMEOUT_MS=400
CUEKB_RERANK_MIN_REMAINING_MS=180
# Applies only when CUEKB_RERANKER_SERVICE_URL is configured.
CUEKB_RERANK_ENABLED=true
CUEKB_VECTOR_DIMENSION=1024
